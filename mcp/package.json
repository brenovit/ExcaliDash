{
  "name": "excalidash-mcp",
  "private": true,
  "description": "MCP server for controlling self-hosted ExcaliDash drawings",
  "author": "Evgeny Soraine",
  "contributors": [
    "Evgeny Abrosimov (https://github.com/LatikDesu)",
    "Breno Nunes Arantes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brenovit/ExcaliDash.git",
    "directory": "mcp"
  },
  "license": "MIT AND LGPL-3.0-only",
  "keywords": [
    "mcp",
    "excalidash",
    "excalidraw"
  ],
  "type": "module",
  "bin": {
