    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
